{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photogenic",
  "version": "0.1.0",
  "identifier": "com.jumpstart.photogenic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "features": ["apple-app"]
  },
  "app": {
    "windows": [{ "title": "Photogenic", "width": 1050, "height": 780 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["../../../Assets/Icons/Photogenic.png"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Mac.entitlements"
    },
    "iOS": { "minimumSystemVersion": "17.0" }
  }
}
